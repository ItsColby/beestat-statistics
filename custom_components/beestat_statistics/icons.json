{
  "services": {
    "get_configuration": {
      "service": "mdi:code-json"
    },
    "import_statistics": {
      "service": "mdi:database-import"
    },
    "repair_filter_change_boundary": {
      "service": "mdi:air-filter"
    },
    "rebuild_statistics": {
      "service": "mdi:database-refresh"
    }
  },
  "entity": {
    "binary_sensor": {
      "active_alert": {
        "default": "mdi:alert-circle-outline",
        "state": {
          "off": "mdi:check-circle-outline",
          "on": "mdi:alert-circle"
        }
      },
      "auto_away_enabled": {
        "default": "mdi:home-export-outline",
        "state": {
          "off": "mdi:home-outline",
          "on": "mdi:home-export-outline"
        }
      },
      "cold_temperature_alert_enabled": {"default": "mdi:snowflake-alert"},
      "equipment_alert": {
        "default": "mdi:alert-circle-outline",
        "state": {
          "off": "mdi:check-circle-outline",
          "on": "mdi:alert-circle"
        }
      },
      "filter_due": {
        "default": "mdi:air-filter",
        "state": {
          "off": "mdi:air-filter",
          "on": "mdi:air-filter-alert"
        }
      },
      "filter_due_soon": {
        "default": "mdi:air-filter",
        "state": {
          "off": "mdi:air-filter",
          "on": "mdi:air-filter-alert"
        }
      },
      "follow_me_enabled": {
        "default": "mdi:motion-sensor",
        "state": {
          "off": "mdi:motion-sensor-off",
          "on": "mdi:motion-sensor"
        }
      },
      "hot_temperature_alert_enabled": {"default": "mdi:thermometer-alert"},
      "microphone_enabled": {"default": "mdi:microphone"},
      "cloud_data_stale": {
        "default": "mdi:cloud-clock",
        "state": {
          "off": "mdi:cloud-check",
          "on": "mdi:cloud-alert"
        }
      },
      "homekit_mapping_incomplete": {
        "default": "mdi:home-search",
        "state": {
          "off": "mdi:home-check",
          "on": "mdi:home-alert"
        }
      },
      "statistics_import_partial": {
        "default": "mdi:database-alert",
        "state": {
          "off": "mdi:database-check",
          "on": "mdi:database-alert"
        }
      },
      "runtime_summary_stale": {
        "default": "mdi:calendar-clock",
        "state": {
          "off": "mdi:calendar-check",
          "on": "mdi:calendar-alert"
        }
      },
      "precooling_enabled": {
        "default": "mdi:snowflake-clock",
        "state": {
          "off": "mdi:snowflake-off",
          "on": "mdi:snowflake-clock"
        }
      },
      "preheating_enabled": {
        "default": "mdi:heat-wave",
        "state": {
          "off": "mdi:radiator-off",
          "on": "mdi:heat-wave"
        }
      },
      "sensor_in_use": {
        "default": "mdi:home-thermometer",
        "state": {
          "off": "mdi:home-thermometer",
          "on": "mdi:thermometer-check"
        }
      },
      "service_reminder_enabled": {"default": "mdi:wrench-clock"},
      "smart_circulation_enabled": {
        "default": "mdi:fan-auto",
        "state": {
          "off": "mdi:fan-off",
          "on": "mdi:fan-auto"
        }
      },
      "wifi_offline_alert_enabled": {"default": "mdi:wifi-alert"}
    },
    "button": {
      "import_statistics": {
        "default": "mdi:database-import"
      },
      "mark_filter_changed": {
        "default": "mdi:air-filter"
      },
      "refresh_runtime": {
        "default": "mdi:sync"
      }
    },
    "date": {
      "filter_changed_date": {
        "default": "mdi:air-filter"
      }
    },
    "sensor": {
      "active_alert_count": {
        "default": "mdi:alert-circle-outline",
        "range": {
          "0": "mdi:check-circle-outline",
          "1": "mdi:alert-circle"
        }
      },
      "active_alert_category": {
        "default": "mdi:alert-decagram-outline",
        "state": {
          "equipment": "mdi:alert-circle",
          "maintenance": "mdi:wrench-clock",
          "none": "mdi:check-circle-outline",
          "unknown": "mdi:alert-decagram-outline"
        }
      },
      "active_sensor_count": {
        "default": "mdi:home-thermometer",
        "range": {
          "0": "mdi:home-thermometer",
          "1": "mdi:thermometer-check"
        }
      },
      "current_profile_room_temperature_spread": {
        "default": "mdi:thermometer-lines"
      },
      "cloud_data_end": {
        "default": "mdi:cloud-clock"
      },
      "cloud_data_lag_minutes": {
        "default": "mdi:cloud-alert",
        "range": {
          "0": "mdi:cloud-check",
          "30": "mdi:cloud-clock",
          "120": "mdi:cloud-alert"
        }
      },
      "current_comfort_profile": {
        "default": "mdi:home-thermometer"
      },
      "compressor_minimum_off_time": {
        "default": "mdi:timer-lock-outline"
      },
      "compressor_minimum_outdoor_temperature": {
        "default": "mdi:snowflake-thermometer"
      },
      "cold_temperature_alert": {"default": "mdi:snowflake-alert"},
      "cooling_differential": {"default": "mdi:snowflake-thermometer"},
      "cooling_dissipation_time": {"default": "mdi:timer-sand"},
      "filter_recent_runtime_hours_per_day": {
        "default": "mdi:clock-outline"
      },
      "filter_remaining_runtime_hours": {
        "default": "mdi:timer-sand"
      },
      "filter_runtime_due_date": {
        "default": "mdi:calendar-clock"
      },
      "filter_max_age_due_date": {
        "default": "mdi:calendar-alert"
      },
      "filter_due_date": {
        "default": "mdi:calendar-check"
      },
      "filter_days_remaining": {
        "default": "mdi:calendar-clock"
      },
      "filter_runtime_hours": {
        "default": "mdi:air-filter"
      },
      "heat_cool_minimum_delta": {
        "default": "mdi:thermometer-chevron-up"
      },
      "heating_differential": {"default": "mdi:radiator"},
      "heating_dissipation_time": {"default": "mdi:timer-sand"},
      "high_humidity_alert": {"default": "mdi:water-percent-alert"},
      "hot_temperature_alert": {"default": "mdi:thermometer-alert"},
      "hold_action": {
        "default": "mdi:gesture-tap-hold"
      },
      "last_service_date": {"default": "mdi:wrench-clock"},
      "low_humidity_alert": {"default": "mdi:water-percent-alert"},
      "metadata_sync_last_success": {
        "default": "mdi:cloud-sync"
      },
      "next_scheduled_comfort_profile_time": {
        "default": "mdi:calendar-arrow-right"
      },
      "playback_volume": {"default": "mdi:volume-high"},
      "runtime_summary_lag_days": {
        "default": "mdi:calendar-remove",
        "range": {
          "0": "mdi:calendar-check",
          "2": "mdi:calendar-clock",
          "4": "mdi:calendar-alert"
        }
      },
      "runtime_summary_latest_date": {
        "default": "mdi:calendar-check"
      },
      "runtime_summary_row_count": {
        "default": "mdi:table"
      },
      "runtime_sync_last_success": {
        "default": "mdi:sync"
      },
      "scheduled_comfort_profile": {
        "default": "mdi:calendar-clock"
      },
      "service_reminder_date": {"default": "mdi:calendar-wrench"},
      "service_reminder_interval": {"default": "mdi:calendar-sync"},
      "statistics_imported_rows": {
        "default": "mdi:database-import"
      },
      "statistics_imported_series": {
        "default": "mdi:chart-multiple"
      },
      "statistics_last_import_success": {
        "default": "mdi:database-check"
      },
      "statistics_source_rows": {
        "default": "mdi:database-search"
      },
      "statistics_skipped_windows": {
        "default": "mdi:database-alert"
      },
      "temperature_correction": {"default": "mdi:thermometer-check"},
      "status": {
        "default": "mdi:cloud-question",
        "state": {
          "error": "mdi:cloud-alert",
          "ok": "mdi:cloud-check",
          "unknown": "mdi:cloud-question"
        }
      }
    }
  }
}
